# Gemini AI
GEMINI_API_KEY=

# Application URL
APP_URL=

# Neon PostgreSQL
DATABASE_URL=
POSTGRES_URL=

# Google Chat
GOOGLE_CHAT_WEBHOOK_URL=

# Legacy Google Sheets, shown as links in Administration (optional, no sync)
GOOGLE_SHEET_AIR_URL=
GOOGLE_SHEET_SEA_URL=

# Vercel Cron (daily tracking refresh). Required: the cron refuses to run without it.
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Parcel photos: Google Drive, shared drive (Google Workspace). A service account
# (Google Cloud, Drive API enabled) is added to the shared drive as
# "Gestionnaire de contenu"; a service account has no storage of its own, so a
# "My Drive" folder does not work. One sub-folder per point Antoine is created.
# The database keeps the Drive file id only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key of the JSON key file ("private_key"), with its \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Id of the photos folder in the shared drive (or of the shared drive itself)
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=

# Odoo DIGI LOGISTIC (read only: invoices addressed to NextHope)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# Destination entity: partner id (preferred) or name (default "NextHope")
ODOO_DEST_PARTNER_ID=
ODOO_DEST_PARTNER_NAME=
