# Gemini AI
GEMINI_API_KEY=

# Application URL
APP_URL=

# Neon PostgreSQL
DATABASE_URL=
POSTGRES_URL=

# Google Chat
GOOGLE_CHAT_WEBHOOK_URL=

# Legacy Google Sheets, shown as links in Administration (optional, no sync)
GOOGLE_SHEET_AIR_URL=
GOOGLE_SHEET_SEA_URL=

# Vercel Cron (daily tracking refresh). Required: the cron refuses to run without it.
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Parcel photos: Neon Object Storage, private bucket (beta). The browser uploads
# with short presigned URLs; the database keeps the object key only.
# NEON_API_KEY: Neon API key with write access to the project.
# Bucket CORS must allow PUT from the application origin (APP_URL).
NEON_API_KEY=
NEON_STORAGE_PROJECT_ID=
NEON_STORAGE_BRANCH_ID=
NEON_STORAGE_BUCKET=

# Odoo DIGI LOGISTIC (read only: invoices addressed to NextHope)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# Destination entity: partner id (preferred) or name (default "NextHope")
ODOO_DEST_PARTNER_ID=
ODOO_DEST_PARTNER_NAME=
